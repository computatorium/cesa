+
+    public function mortform(Doku_Event $event, $param) {
+        for ($i = 0; $i < $event->data->elementCount(); $i++) {
+            $element = $event->data->getElementAt($i);
+            if ($element instanceof \dokuwiki\Form\HTMLElement) {
+                $element->val($this->maskUserIPs($element->val()));
+            }
+        }
+    }
+
+    public function mortdiff(Doku_Event $event, $param) {
+        global $INPUT;
+        if ($INPUT->str('do') === 'diff') $event->data = $this->maskUserIPs($event->data);
+    }
+
+    private function maskUserIPs($html) {
+        $permission = $this->getConf('rightToSeeIP');
+        if (($permission === 'mg' && auth_ismanager()) || ($permission === 'sp' && auth_isadmin())) {
+            return $html;
+        }
+        $display = hsc($this->getLang('notloggedin'));
+        return preg_replace_callback('/<span class="user">(.*?)<\/span>/s', function ($user) use ($display) {
+            $body = preg_replace_callback('/<(bdo|bdi)(?: dir="ltr")?>([^<]*)<\/\1>/', function ($value) use ($display) {
+                $ip = trim(html_entity_decode($value[2], ENT_QUOTES, 'UTF-8'), "() \t\n\r");
+                if (filter_var($ip, FILTER_VALIDATE_IP) === false) return $value[0];
+                return strpos($value[2], '(') !== false ? '' : '<bdi>' . $display . '</bdi>';
+            }, $user[1]);
+            return '<span class="user">' . $body . '</span>';
+        }, $html);
     }
 
